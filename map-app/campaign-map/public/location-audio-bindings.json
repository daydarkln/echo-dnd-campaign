        "musicModifier": 0.7
      }
    },
    "timeOfDay": {
      "morning": {
        "ambientModifier": 1.2,
        "musicModifier": 1.0,
        "volumeModifier": 1.1
      },
      "day": {
        "ambientModifier": 1.0,
        "musicModifier": 1.0,
        "volumeModifier": 1.0
      },
      "evening": {
        "ambientModifier": 0.8,
        "musicModifier": 0.9,
        "volumeModifier": 0.9
      },
      "night": {
        "ambientModifier": 0.6,
